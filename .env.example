# ==============================================================================
# KONFIGURASI DEFAULT MQTT OVER WSS (OPSIONAL UNTUK BUILD)
# ==============================================================================
# Catatan Keamanan:
# 1. Jangan pernah mengunggah file .env berisi kredensial asli ke repository GitHub.
# 2. Variabel VITE_* akan dibundel ke frontend static JS. Gunakan akun MQTT khusus
#    website dengan hak akses ACL terbatas hanya pada topic smarthome/#.
# 3. Anda juga dapat mengisi konfigurasi ini langsung di halaman Settings website
#    (tersimpan secara lokal di browser pengguna).

VITE_MQTT_BROKER=wss://YOUR_BROKER_HOST:YOUR_WSS_PORT/YOUR_PATH
VITE_MQTT_USERNAME=YOUR_USERNAME
VITE_MQTT_PASSWORD=YOUR_PASSWORD
